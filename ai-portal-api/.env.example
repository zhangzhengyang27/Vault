# 后端环境变量示例（复制为 .env 后填写）

# 服务端口（默认 3001）
PORT=3001

# PostgreSQL 连接串（必填）
DATABASE_URL=postgres://user:password@localhost:5432/ai_portal

# JWT 签名密钥（必填，强随机：openssl rand -hex 32）
JWT_SECRET=change-me-to-a-strong-random-secret

# 运行环境：production 时 cookie 仅经 HTTPS 传输，且禁止开发默认密钥
# NODE_ENV=production
# 未设置 NODE_ENV 的 HTTPS 部署可显式开启安全 cookie
# COOKIE_SECURE=true

# 反向代理跳数或 true：让限流/日志拿到真实客户端 IP（仅在有代理时设置）
# TRUST_PROXY=1

# CORS 白名单（逗号分隔）
# 生产示例：CORS_ORIGINS=https://vault.zhangzhengyang.com,https://vault-admin.zhangzhengyang.com
# CORS_ORIGINS=http://localhost:3000

# 管理员账号引导（可选）：配置后应用启动时自动创建/提升管理员账号
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me
# ADMIN_EMAIL=admin@example.com

# 演示数据：显式开启才会在空库创建 demo/demo1234 管理员（仅限本地演示）
# SEED_DEMO=true

# Firecrawl 网页抓取（二选一：托管 API 填 Key，自托管填 Base URL）
# FIRECRAWL_API_KEY=fc-your-key-here
# FIRECRAWL_BASE_URL=http://localhost:3002
# FIRECRAWL_TIMEOUT=30000

# 开发时如需临时让 TypeORM 自动同步表结构（生产禁止）
# TYPEORM_SYNCHRONIZE=true
