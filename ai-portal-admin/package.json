{
  "name": "ai-portal-admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=4096 vite",
    "serve": "pnpm dev",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && NODE_OPTIONS=--max-old-space-size=8192 vite build",
    "build:staging": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && vite build --mode staging",
    "report": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && vite build",
    "preview": "vite preview",
    "preview:build": "pnpm build && vite preview",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "preinstall": "npx only-allow pnpm",
    "lint": "eslint --cache --max-warnings 0 src",
    "lint:fix": "eslint --cache --fix src"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@iconify-json/ep": "^1.0.4",
    "@iconify-json/ri": "^1.0.4",
    "@iconify/vue": "^5.0.0",
    "@pureadmin/utils": "^2.5.0",
    "@vueuse/core": "^13.0.0",
    "axios": "^1.10.0",
    "dayjs": "^1.11.13",
    "echarts": "^5.6.0",
    "element-plus": "^2.10.0",
    "js-cookie": "^3.0.5",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.0",
    "tippy.js": "^6.3.7",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1",
    "vue-tippy": "^6.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^24.0.0",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.0.0",
    "vite-plugin-compression2": "^2.5.3",
    "vite-svg-loader": "^5.1.0",
    "vue-tsc": "^3.0.0"
  }
}
