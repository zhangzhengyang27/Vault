{
  "manifest_version": 3,
  "name": "AI 提示词助手",
  "version": "1.2.0",
  "description": "一键插入精选 AI 提示词到任意输入框，支持分类浏览和搜索",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AI 提示词助手"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
